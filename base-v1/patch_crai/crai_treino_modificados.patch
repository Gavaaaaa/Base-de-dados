+    """Módulo 1: valor, sazonalidade (Fonte A) e peso de insufficient_funds (Fonte B)."""
+    log_valor = np.log(amostra["payment_value"].to_numpy(dtype=float))
+    mu, sigma = float(log_valor.mean()), float(log_valor.std(ddof=0))
