+        serie = pd.to_numeric(pd.Series([d["valor"] for d in dados]), errors="coerce").dropna()
+        if len(serie):
+            return {
+                "media": round(float(serie.mean()), 4),
+                "ultimo": round(float(serie.iloc[-1]), 4),
+                "n_obs": int(len(serie)),
